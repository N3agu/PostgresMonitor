<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PostgresMonitor</title>

    <link rel="icon" type="image/png" href="~/images/elephant.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (function () {
            const saved = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>

    <style>
        :root {
            --pm-violet-50: #f5edff;
            --pm-violet-100: #e6d4ff;
            --pm-violet-300: #b794f6;
            --pm-violet-400: #9f7aea;
            --pm-violet-500: #8b5cf6;
            --pm-violet-600: #7c3aed;
            --pm-violet-700: #6d28d9;
            --pm-violet-900: #3b1078;
            --pm-teal-400: #2dd4bf;
            --pm-teal-500: #14b8a6;
            --pm-pink-400: #f472b6;
            --pm-success: #34d399;
            --pm-warning: #fbbf24;
            --pm-danger: #f87171;
        }

        [data-bs-theme="dark"] {
            --bs-body-bg: #0a0a0f;
            --bs-body-color: #e5e7eb;
            --bs-secondary-color: rgba(229, 231, 235, 0.65);
            --bs-tertiary-color: rgba(229, 231, 235, 0.45);
            --bs-card-bg: #14141c;
            --bs-card-border-color: rgba(255, 255, 255, 0.06);
            --bs-border-color: rgba(255, 255, 255, 0.08);
            --bs-border-color-translucent: rgba(255, 255, 255, 0.06);
            --pm-surface: #14141c;
            --pm-surface-2: #1c1c28;
            --pm-surface-hover: #22222e;
            --pm-nav-bg: rgba(10, 10, 15, 0.85);
            --pm-input-bg: #1c1c28;
            --pm-input-border: rgba(255, 255, 255, 0.1);
            --pm-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            --pm-shadow-lg: 0 10px 40px rgba(0, 0, 0, 0.5);
            --pm-primary: var(--pm-violet-500);
            --pm-primary-hover: var(--pm-violet-400);
            --pm-accent: var(--pm-teal-400);
            --pm-accent-2: var(--pm-pink-400);
            --pm-text-muted: rgba(229, 231, 235, 0.55);
            --pm-divider: rgba(255, 255, 255, 0.06);
            color-scheme: dark;
        }

        [data-bs-theme="light"] {
            --bs-body-bg: #fafafb;
            --bs-body-color: #1f2937;
            --bs-secondary-color: rgba(31, 41, 55, 0.7);
            --bs-tertiary-color: rgba(31, 41, 55, 0.5);
            --bs-card-bg: #ffffff;
            --bs-card-border-color: rgba(17, 24, 39, 0.08);
            --bs-border-color: rgba(17, 24, 39, 0.1);
            --bs-border-color-translucent: rgba(17, 24, 39, 0.08);
            --pm-surface: #ffffff;
            --pm-surface-2: #f4f4f7;
            --pm-surface-hover: #f4f4f7;
            --pm-nav-bg: rgba(255, 255, 255, 0.85);
            --pm-input-bg: #ffffff;
            --pm-input-border: rgba(17, 24, 39, 0.15);
            --pm-shadow: 0 1px 3px rgba(17, 24, 39, 0.06), 0 1px 2px rgba(17, 24, 39, 0.04);
            --pm-shadow-lg: 0 10px 30px rgba(17, 24, 39, 0.1);
            --pm-primary: var(--pm-violet-600);
            --pm-primary-hover: var(--pm-violet-700);
            --pm-accent: var(--pm-teal-500);
            --pm-accent-2: #db2777;
            --pm-text-muted: rgba(31, 41, 55, 0.6);
            --pm-divider: rgba(17, 24, 39, 0.08);
            color-scheme: light;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(139, 92, 246, 0.12), transparent 70%), var(--bs-body-bg);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        [data-bs-theme="light"] body {
            background: radial-gradient(ellipse 80% 40% at 50% -10%, rgba(139, 92, 246, 0.08), transparent 70%), var(--bs-body-bg);
        }

        .navbar-custom {
            background-color: var(--pm-nav-bg);
            backdrop-filter: saturate(180%) blur(12px);
            -webkit-backdrop-filter: saturate(180%) blur(12px);
            border-bottom: 1px solid var(--pm-divider);
        }

        .navbar-brand strong {
            background: linear-gradient(135deg, var(--pm-violet-400), var(--pm-accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .nav-link {
            color: var(--bs-body-color) !important;
            opacity: 0.7;
            font-size: 0.925rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 6px;
            transition: all 0.15s ease;
        }

            .nav-link:hover {
                opacity: 1;
                background: var(--pm-surface-2);
            }

            .nav-link.active {
                opacity: 1;
                color: var(--pm-primary) !important;
            }

        .btn-primary {
            background-color: var(--pm-primary);
            border-color: var(--pm-primary);
            color: white;
            font-weight: 500;
            transition: all 0.15s ease;
        }

            .btn-primary:hover,
            .btn-primary:focus {
                background-color: var(--pm-primary-hover);
                border-color: var(--pm-primary-hover);
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(139, 92, 246, 0.35);
            }

        .btn-icon {
            background: transparent;
            border: 1px solid transparent;
            color: var(--pm-text-muted);
            border-radius: 6px;
            padding: 0.35rem 0.55rem;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-icon:hover {
                background: var(--pm-surface-hover);
                color: var(--bs-body-color);
                border-color: var(--bs-border-color);
            }

            .btn-icon.btn-icon-primary:hover {
                color: var(--pm-primary);
            }

            .btn-icon.btn-icon-success:hover {
                color: var(--pm-success);
            }

            .btn-icon.btn-icon-danger:hover {
                color: var(--pm-danger);
            }

        .theme-toggle {
            background: var(--pm-surface-2);
            border: 1px solid var(--bs-border-color);
            color: var(--bs-body-color);
            border-radius: 8px;
            padding: 0.4rem 0.75rem;
            font-size: 0.85rem;
            transition: all 0.15s ease;
        }

            .theme-toggle:hover {
                background: var(--pm-surface-hover);
            }

        .card {
            background-color: var(--bs-card-bg);
            border: 1px solid var(--bs-card-border-color);
            border-radius: 12px;
            box-shadow: var(--pm-shadow);
        }

        .card-header {
            background: transparent;
            border-bottom-color: var(--pm-divider);
        }

        .metric-card {
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

            .metric-card::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 3px;
                background: var(--metric-color, var(--pm-primary));
                opacity: 0.9;
            }

            .metric-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--pm-shadow-lg);
            }

        .metric-label {
            font-size: 0.7rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--pm-text-muted);
            font-weight: 600;
        }

        .metric-value {
            font-size: 2.1rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--metric-color, var(--bs-body-color));
        }

        .metric-unit {
            font-size: 0.95rem;
            color: var(--pm-text-muted);
            font-weight: 400;
            margin-left: 0.2rem;
        }

        .metric-icon {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 1.5rem;
            color: var(--metric-color, var(--pm-primary));
            opacity: 0.18;
        }

        .table-custom {
            --bs-table-bg: transparent;
            --bs-table-color: var(--bs-body-color);
            margin-bottom: 0;
        }

            .table-custom thead th {
                font-size: 0.7rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                font-weight: 600;
                color: var(--pm-text-muted);
                border-bottom: 1px solid var(--pm-divider);
                padding: 1rem 0.75rem;
            }

            .table-custom tbody tr {
                border-bottom: 1px solid var(--pm-divider);
                transition: background-color 0.15s ease;
            }

                .table-custom tbody tr:last-child {
                    border-bottom: none;
                }

                .table-custom tbody tr:hover {
                    background-color: var(--pm-surface-hover);
                }

            .table-custom td {
                padding: 1rem 0.75rem;
                vertical-align: middle;
            }

        .form-label {
            font-size: 0.72rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--pm-text-muted);
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .form-control,
        .form-select {
            background-color: var(--pm-input-bg);
            border: 1px solid var(--pm-input-border);
            color: var(--bs-body-color);
            border-radius: 8px;
            padding: 0.6rem 0.85rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .form-control:focus,
            .form-select:focus {
                background-color: var(--pm-input-bg);
                border-color: var(--pm-primary);
                color: var(--bs-body-color);
                box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);
            }

            .form-control::placeholder {
                color: var(--pm-text-muted);
                opacity: 0.6;
            }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.72rem;
            font-weight: 500;
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            letter-spacing: 0.02em;
        }

        .badge-active {
            background: rgba(52, 211, 153, 0.12);
            color: var(--pm-success);
            border: 1px solid rgba(52, 211, 153, 0.25);
        }

        .badge-idle {
            background: var(--pm-surface-2);
            color: var(--pm-text-muted);
            border: 1px solid var(--bs-border-color);
        }

        .badge-live {
            background: rgba(139, 92, 246, 0.12);
            color: var(--pm-primary);
            border: 1px solid rgba(139, 92, 246, 0.3);
            font-family: 'SF Mono', Monaco, monospace;
            font-size: 0.78rem;
        }

        .pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            animation: pulse 1.8s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.85);
            }
        }

        .alert {
            border-radius: 10px;
            border: 1px solid var(--bs-border-color);
            background-color: var(--bs-card-bg);
        }

        .alert-success {
            background: rgba(52, 211, 153, 0.08);
            border-color: rgba(52, 211, 153, 0.25);
            color: var(--pm-success);
        }

        h1, h2, h3, h4, h5 {
            letter-spacing: -0.015em;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 600;
            letter-spacing: -0.025em;
            margin-bottom: 0.25rem;
        }

        .page-subtitle {
            color: var(--pm-text-muted);
            font-size: 0.95rem;
        }

        .text-muted {
            color: var(--pm-text-muted) !important;
        }

        .divider {
            height: 1px;
            background: var(--pm-divider);
            margin: 1.5rem 0;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--pm-surface-hover);
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--pm-text-muted);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm sticky-top navbar-custom mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/elephant.png" alt="Logo" width="28" height="28" class="me-2 rounded">
                    <strong>PostgresMonitor</strong>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Settings" asp-action="Index">
                                <i class="bi bi-sliders me-1"></i> Settings
                            </a>
                        </li>
                    </ul>
                    <button id="themeToggle" class="theme-toggle d-flex align-items-center gap-2">
                        <i id="themeIcon" class="bi bi-moon-stars"></i>
                        <span id="themeText">Dark</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const htmlEl = document.documentElement;
            const toggleBtn = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');

            applyThemeUi(htmlEl.getAttribute('data-bs-theme'));

            toggleBtn.addEventListener('click', () => {
                const current = htmlEl.getAttribute('data-bs-theme');
                const next = current === 'light' ? 'dark' : 'light';
                htmlEl.setAttribute('data-bs-theme', next);
                localStorage.setItem('theme', next);
                applyThemeUi(next);
                document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
            });

            function applyThemeUi(theme) {
                if (theme === 'dark') {
                    themeIcon.className = 'bi bi-moon-stars';
                    themeText.innerText = 'Dark';
                } else {
                    themeIcon.className = 'bi bi-sun-fill';
                    themeText.innerText = 'Light';
                }
            }
        });
    </script>
</body>
</html>
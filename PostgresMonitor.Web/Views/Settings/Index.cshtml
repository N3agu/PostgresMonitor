@model List<PostgresMonitor.Web.Models.DbSettings>

@{
    ViewData["Title"] = "Database Management";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Configuration</h1>
        <p class="page-subtitle mb-0">Manage your PostgreSQL connections</p>
    </div>
    <a asp-action="Edit" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Add Database
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th class="ps-4">Status</th>
                    <th>Alias</th>
                    <th>Target</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2" style="color: var(--pm-text-muted); opacity: 0.5;"></i>
                            <div class="text-muted">No databases configured</div>
                            <a asp-action="Edit" class="btn btn-primary rounded-pill px-4 mt-3">
                                <i class="bi bi-plus-lg me-1"></i> Add your first database
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var db in Model)
                {
                    <tr>
                        <td class="ps-4">
                            @if (db.IsActive)
                            {
                                <span class="badge-status badge-active">
                                    <span class="pulse-dot"></span>
                                    Monitoring
                                </span>
                            }
                            else
                            {
                                <span class="badge-status badge-idle">
                                    <i class="bi bi-pause-circle"></i>
                                    Idle
                                </span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@db.ConnectionName</div>
                        </td>
                        <td>
                            <div style="font-family: 'SF Mono', Monaco, monospace; font-size: 0.875rem;">
                                @db.Host<span class="text-muted">:@db.Port</span>
                            </div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-database me-1"></i>@db.Database
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                @if (!db.IsActive)
                                {
                                    <form asp-action="SetActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@db.Id" />
                                        <button type="submit" class="btn-icon btn-icon-success" title="Set Active">
                                            <i class="bi bi-play-circle"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@db.Id" class="btn-icon btn-icon-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this configuration?');">
                                    <input type="hidden" name="id" value="@db.Id" />
                                    <button type="submit" class="btn-icon btn-icon-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
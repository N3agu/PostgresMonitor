@model List<PostgresMonitor.Web.Models.DbSettings>

@{
    ViewData["Title"] = "Database Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Database Management</h2>
        <a asp-action="Edit" class="btn btn-primary">Add New Database</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Status</th>
                    <th>Name</th>
                    <th>Host:Port</th>
                    <th>Database</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center">No databases configured.</td></tr>
                }
                @foreach (var db in Model)
                {
                    <tr>
                        <td>
                            @if (db.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td><strong>@db.ConnectionName</strong></td>
                        <td>@db.Host:@db.Port</td>
                        <td>@db.Database</td>
                        <td>
                            <div class="d-flex gap-2">
                                @if (!db.IsActive)
                                {
                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@db.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Set Active</button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@db.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="id" value="@db.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@model PostgresMonitor.Web.Models.DbSettings

@{
    ViewData["Title"] = "Database Settings";
}

<div class="container mt-4">
    <h2>Database Configuration</h2>
    <p class="text-muted">Configure the PostgreSQL database you want to monitor.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <form asp-action="Save" method="post">
                <div class="mb-3">
                    <label asp-for="Host" class="form-label">Host</label>
                    <input asp-for="Host" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Port" class="form-label">Port</label>
                    <input asp-for="Port" type="number" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Database" class="form-label">Database Name</label>
                    <input asp-for="Database" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Save Settings</button>
            </form>
        </div>
    </div>
</div>
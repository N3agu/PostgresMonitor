@model PostgresMonitor.Web.Models.DbSettings

@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "New Connection" : "Edit Connection";
    var isNew = Model.Id == Guid.Empty;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center">
        <i class="bi bi-arrow-left me-1"></i> Back to list
    </a>
    <h1 class="page-title mt-2 mb-1">@(isNew ? "New Connection" : "Edit Connection")</h1>
    <p class="page-subtitle mb-0">
        @(isNew ? "Configure a PostgreSQL database for monitoring." : "Update connection details for this database.")
    </p>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsActive" />

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="ConnectionName" class="form-label">Alias</label>
                    <input asp-for="ConnectionName" class="form-control"
                           placeholder="e.g. Production Read Replica" required autocomplete="off" />
                    <div class="form-text small text-muted mt-1">A friendly name shown in the dashboard.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="PollingIntervalSeconds" class="form-label">Polling Interval</label>
                    <select asp-for="PollingIntervalSeconds" class="form-select">
                        <option value="5">5 seconds (Aggressive)</option>
                        <option value="10">10 seconds (Standard)</option>
                        <option value="15">15 seconds</option>
                        <option value="30">30 seconds (Relaxed)</option>
                        <option value="60">1 minute</option>
                    </select>
                    <div class="form-text small text-muted mt-1">How often to collect telemetry.</div>
                </div>
            </div>

            <div class="divider"></div>

            <h6 class="fw-semibold mb-3 mt-1">
                <i class="bi bi-hdd-network me-2" style="color: var(--pm-primary);"></i>Server
            </h6>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Host" class="form-label">Host</label>
                    <input asp-for="Host" class="form-control"
                           placeholder="db.example.com" required autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Port" class="form-label">Port</label>
                    <input asp-for="Port" type="number" class="form-control" required min="1" max="65535" />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Database" class="form-label">Database Name</label>
                <input asp-for="Database" class="form-control" placeholder="postgres" required autocomplete="off" />
            </div>

            <div class="divider"></div>

            <h6 class="fw-semibold mb-3 mt-1">
                <i class="bi bi-key me-2" style="color: var(--pm-primary);"></i>Credentials
            </h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" required autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="position-relative">
                        <input asp-for="Password" type="password" id="passwordInput"
                               class="form-control pe-5" placeholder="••••••••"
                               autocomplete="new-password" />
                        <button type="button" class="btn-icon position-absolute top-50 end-0 translate-middle-y me-2"
                                onclick="togglePassword()" tabindex="-1" aria-label="Toggle password visibility">
                            <i class="bi bi-eye" id="passwordToggleIcon"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Password" style="color: var(--pm-danger);" class="small mt-1 d-block fw-semibold"></span>

                    @if (!isNew)
                    {
                        <div class="form-text small text-muted mt-1">Leave empty to keep the current password.</div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end pt-3 mt-4" style="border-top: 1px solid var(--pm-divider);">
                <a asp-action="Index" class="btn btn-icon px-4">Cancel</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-check2 me-1"></i> Save Configuration
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePassword() {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('passwordToggleIcon');
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
    }
</script>
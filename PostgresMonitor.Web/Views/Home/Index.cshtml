@model List<PostgresMonitor.Web.Models.HealthMetrics>

@{
    ViewData["Title"] = "Overview";
    var latest = Model.LastOrDefault();
    var graphData = Model.OrderBy(m => m.Timestamp).ToList();
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">System Overview</h1>
        <p class="page-subtitle mb-0">Real-time PostgreSQL telemetry</p>
    </div>
    @if (latest != null)
    {
        <span class="badge-status badge-live">
            <span class="pulse-dot"></span>
            Live · @latest.Timestamp.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (latest == null)
{
    <div class="card p-5 text-center">
        <i class="bi bi-broadcast fs-1 mb-3" style="color: var(--pm-primary); opacity: 0.5;"></i>
        <h5 class="fw-normal mb-1">Waiting for telemetry</h5>
        <p class="text-muted mb-0">The background service hasn't reported any data yet.</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card h-100 p-4" style="--metric-color: var(--pm-violet-500);">
                <i class="bi bi-diagram-3 metric-icon"></i>
                <div class="metric-label mb-2">Active Connections</div>
                <div class="metric-value">@latest.ActiveConnections</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card h-100 p-4" style="--metric-color: var(--pm-accent-2);">
                <i class="bi bi-hourglass-split metric-icon"></i>
                <div class="metric-label mb-2">Slow Queries</div>
                <div class="metric-value">@latest.SlowQueries</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card h-100 p-4" style="--metric-color: var(--pm-accent);">
                <i class="bi bi-cpu metric-icon"></i>
                <div class="metric-label mb-2">CPU Load</div>
                <div class="metric-value">@latest.CpuUsage<span class="metric-unit">%</span></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card h-100 p-4" style="--metric-color: var(--pm-violet-400);">
                <i class="bi bi-memory metric-icon"></i>
                <div class="metric-label mb-2">Available RAM</div>
                <div class="metric-value">@latest.MemoryUsage<span class="metric-unit">MB</span></div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-3 px-4">
                    <h6 class="mb-0 fw-semibold">Connections & Latency</h6>
                </div>
                <div class="card-body p-4">
                    <canvas id="connectionsChart" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-3 px-4">
                    <h6 class="mb-0 fw-semibold">System Processing</h6>
                </div>
                <div class="card-body p-4">
                    <canvas id="resourcesChart" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(graphData));
        const labels = rawData.map(d => new Date(d.Timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }));

        function readTheme() {
            const s = getComputedStyle(document.documentElement);
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            return {
                primary:   s.getPropertyValue('--pm-primary').trim()   || '#8b5cf6',
                accent:    s.getPropertyValue('--pm-accent').trim()    || '#2dd4bf',
                accent2:   s.getPropertyValue('--pm-accent-2').trim()  || '#f472b6',
                muted:     s.getPropertyValue('--pm-text-muted').trim() || '#888',
                grid:      isDark ? 'rgba(255,255,255,0.06)' : 'rgba(17,24,39,0.08)',
                tickColor: isDark ? 'rgba(229,231,235,0.55)' : 'rgba(31,41,55,0.6)',
                tooltipBg: isDark ? '#1c1c28' : '#ffffff',
                tooltipBorder: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(17,24,39,0.1)',
                tooltipText: isDark ? '#e5e7eb' : '#1f2937'
            };
        }

        function hexToRgba(hex, alpha) {
            if (hex.startsWith('#') && hex.length === 7) {
                const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
                return `rgba(${r},${g},${b},${alpha})`;
            }
            return hex;
        }

        function buildChartOptions(t) {
            return {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: t.tickColor,
                            usePointStyle: true,
                            pointStyle: 'circle',
                            padding: 16,
                            font: { size: 12 }
                        }
                    },
                    tooltip: {
                        backgroundColor: t.tooltipBg,
                        titleColor: t.tooltipText,
                        bodyColor: t.tooltipText,
                        borderColor: t.tooltipBorder,
                        borderWidth: 1,
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: true,
                        boxPadding: 4
                    }
                },
                scales: {
                    x: {
                        grid: { color: t.grid, drawBorder: false },
                        ticks: { color: t.tickColor, font: { size: 11 }, maxRotation: 0, autoSkipPadding: 16 }
                    },
                    y: {
                        grid: { color: t.grid, drawBorder: false },
                        ticks: { color: t.tickColor, font: { size: 11 } },
                        beginAtZero: true
                    }
                },
                elements: { point: { radius: 0, hoverRadius: 5 } }
            };
        }

        let connectionsChart, resourcesChart;

        function renderCharts() {
            const t = readTheme();

            const connDs = [
                {
                    label: 'Active Connections',
                    data: rawData.map(d => d.ActiveConnections),
                    borderColor: t.primary,
                    backgroundColor: hexToRgba(t.primary, 0.15),
                    borderWidth: 2,
                    fill: true,
                    tension: 0.35
                },
                {
                    label: 'Slow Queries',
                    data: rawData.map(d => d.SlowQueries),
                    borderColor: t.accent2,
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    borderDash: [4, 4],
                    tension: 0.2,
                    fill: false
                }
            ];

            const resDs = [{
                label: 'CPU Usage (%)',
                data: rawData.map(d => d.CpuUsage),
                borderColor: t.accent,
                backgroundColor: hexToRgba(t.accent, 0.15),
                borderWidth: 2,
                fill: true,
                tension: 0.35
            }];

            const opts = buildChartOptions(t);

            if (connectionsChart) connectionsChart.destroy();
            if (resourcesChart)   resourcesChart.destroy();

            connectionsChart = new Chart(document.getElementById('connectionsChart'), {
                type: 'line',
                data: { labels, datasets: connDs },
                options: opts
            });

            resourcesChart = new Chart(document.getElementById('resourcesChart'), {
                type: 'line',
                data: { labels, datasets: resDs },
                options: opts
            });
        }

        renderCharts();
        document.addEventListener('themechange', renderCharts);
    </script>
}